@startuml
skinparam backgroundColor white
skinparam componentStyle rectangle
skinparam shadowing false
skinparam linetype ortho
skinparam ArrowThickness 3

title MiRACLE v1.0 - High Level Architecture

' Color scheme
' Data sources:      ***REMOVED***D9EDF7
' Models / RL:       ***REMOVED***E6E6FA
' Processing blocks: ***REMOVED***FCF8E3
' Storage / outputs: ***REMOVED***F5F5F5

' -----------------------------
' Data sources
' -----------------------------
package "PV Plant Data" ***REMOVED***D9EDF7 {
  [Historical PV Output] as HIST_PV
  [Historical Weather] as HIST_W
  [PV Metadata] as PVM
}

package "Weather Forecast API" ***REMOVED***D9EDF7 {
  [Ensemble Weather Forecasts] as W_API
}

' -----------------------------
' Core processing blocks
' -----------------------------
rectangle "Preprocessor A\n(Historic preprocessing)" as PA ***REMOVED***FCF8E3
rectangle "Preprocessor B\n(Real time preprocessing)" as PB ***REMOVED***FCF8E3

rectangle "LSTM Encoder\n(Temporal encodings)" as LSTM ***REMOVED***E6E6FA
rectangle "PVLib Physical Model\n(Physics features)" as PVLIB ***REMOVED***E6E6FA
rectangle "Temporal Fusion Transformer\n(Final forecaster)" as TFT ***REMOVED***E6E6FA

node "RL Meta Controller\n(Double DQN)" as RL ***REMOVED***E6E6FA

' -----------------------------
' Storage and outputs
' -----------------------------
database "Feature Store" as FS ***REMOVED***F5F5F5
database "Model and Config Store" as MS ***REMOVED***F5F5F5
rectangle "Predicted PV\nPower Output" as OUT ***REMOVED***F5F5F5
rectangle "Dashboard\n(Explainability & Ops)" as DASH ***REMOVED***F5F5F5

' -----------------------------
' Main data flow
' -----------------------------
HIST_PV --> PA
HIST_W  --> PA
PA --> LSTM
PA --> PVLIB

LSTM --> FS
PVLIB --> FS

W_API --> PB
PB --> FS

FS --> TFT
TFT --> OUT
TFT --> DASH

' -----------------------------
' RL interaction (high level)
' -----------------------------
OUT --> RL : errors, drift
W_API --> RL : API quality
RL --> PB : route / cadence decisions
RL ..> MS : store policies

' -----------------------------
' Model storage links (light)
' -----------------------------
LSTM ..> MS : encoder weights
PVLIB ..> MS : physics config
TFT  ..> MS : forecaster weights

MS --> DASH

@enduml
