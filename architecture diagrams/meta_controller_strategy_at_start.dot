    "TFT Model" -> "PV Power Forecast";

    "Real-time Weather API Data" -> "Meta Controller 1" [label="Error Monitoring"];
    "PV Power Forecast" -> "Meta Controller 1";
    "Meta Controller 1" -> "Trigger TFT Retraining?" [label="Decision"];
