@startuml
' High-fidelity PlantUML — local / VS Code rendering
' Hybrid Ensemble PV Forecasting Architecture (Final)

' -----------------------------
' Styling
' -----------------------------
skinparam backgroundColor #FFFFFF
skinparam componentStyle rectangle
skinparam databaseBackgroundColor #F5F5F5
skinparam rectangleBorderColor #0066cc
skinparam linetype ortho
skinparam shadowing false
skinparam defaultTextAlignment center

title Hybrid Ensemble PV Forecasting Architecture (Final) - High fidelity

' -----------------------------
' Colors (explicit)
' -----------------------------
' inputs:    #d6f5d6
' models:    #cce0ff
' stores:    #f2f2f2
' error:     #ffe0b3
' output:    #fff5b3
' dashboard: #ccf5f5

' -----------------------------
' Data Sources (top)
' -----------------------------
package "Data Source 1: PV Plant" as DS1 #d6f5d6 {
    [Historical PV Output] as HIST_PV
    [Historical Weather Data] as HIST_W
    [PV Plant Metadata] as PVM
}

package "Data Source 2: OpenMeteo (Forecasts)" as DS2 #d6f5d6 {
    [Forecast API] as FORECAST_API
    package "Ensemble API" as ENS {
        [GFS Ensemble] as GFS
        [ICON EPS] as ICON_EPS
        [ICON EU] as ICON_EU
        [ICON D2] as ICON_D2
        [ECMWF IFS] as ECMWF_IFS
        [ECMWF AIFS] as ECMWF_AIFS
        [GEM Global] as GEM
    }
}

' -----------------------------
' RL Meta-Controller (center)
' -----------------------------
node "RL Meta-Controller\n(Adaptive Control Loop)" as RL #cce0ff

' -----------------------------
' Historical Store + Preprocessors
' -----------------------------
database "Historical Store" as HDB #f2f2f2
rectangle "Preprocessor A\n(Data Normalization)" as PA #cce0ff
rectangle "Preprocessor B\n(Real-time Preprocessing)" as PB #cce0ff

' -----------------------------
' Stores & Outputs
' -----------------------------
database "Feature Store" as FS #f2f2f2
database "Model Store" as MS #f2f2f2
database "Metadata Table\n(Pipeline & Model Metadata)" as MT #f2f2f2
database "Error Metrics Table" as EM #ffe0b3
database "TFT Output Table" as OT #f2f2f2

' -----------------------------
' Models
' -----------------------------
rectangle "LSTM Encoder\n(Temporal Encodings)" as LSTM #cce0ff
rectangle "PVLib Physical Model\n(Baseline physics simulation)" as PVLIB #cce0ff
rectangle "Temporal Fusion Transformer\n(Main Forecasting Model)" as TFT #cce0ff

' -----------------------------
' Dashboard & Final Output
' -----------------------------
rectangle "Streamlit Dashboard\n(Explainability & Decision Support)" as DASH #ccf5f5
rectangle "Predicted PV Power Output" as OUT #fff5b3

' =====================================================
' Arrow thickness rules
'  - main: thickness 3
'  - DS2 -> RL inputs: thickness 2
'  - feedback/dotted: thickness 2
' =====================================================

' -----------------------------
' Main arrows thickness
' -----------------------------
skinparam ArrowThickness 3

' Historical flow -> preprocess -> LSTM -> FS
HIST_PV -[#000000,thickness=3]-> HDB
HIST_W  -[#000000,thickness=3]-> HDB
HDB     -[#000000,thickness=3]-> PA
PA      -[#000000,thickness=3]-> LSTM
LSTM    -[#000000,thickness=3]-> FS

' PV metadata -> PVLib -> FS
PVM     -[#000000,thickness=3]-> PVLIB
PVLIB   -[#000000,thickness=3]-> FS

' -----------------------------
' DS2 inputs -> RL (slightly thinner) connecting to top of RL
' -----------------------------
skinparam ArrowThickness 2
FORECAST_API -top-> RL
GFS          -top-> RL
ICON_EPS     -top-> RL
ICON_EU      -top-> RL
ICON_D2      -top-> RL
ECMWF_IFS    -top-> RL
ECMWF_AIFS   -top-> RL
GEM          -top-> RL

' restore main thickness for downstream
skinparam ArrowThickness 3

' -----------------------------
' RL -> Preprocessor B (center-bottom to center-top) — main thickness
' -----------------------------
RL -bottom-> PB
PB -[#000000,thickness=3]-> FS

' -----------------------------
' TFT input aggregation and outputs
' -----------------------------
FS -[#000000,thickness=3]-> TFT
PVLIB -[#000000,thickness=3]-> TFT
PB -[#000000,thickness=3]-> TFT

TFT -[#000000,thickness=3]-> OT
OT  -[#000000,thickness=3]-> DASH
OT  -[#000000,thickness=3]-> EM
OT  -[#000000,thickness=3]-> OUT

' -----------------------------
' Feedback (thin) and dotted storage link from bottom of RL
' -----------------------------
skinparam ArrowThickness 2
EM -[#000000,thickness=2]-> RL
RL -bottom..> MS : store policies

' -----------------------------
' Model store secondary dotted links
' -----------------------------
LSTM ..[#808080]> MS
PVLIB ..[#808080]> MS
TFT ..[#808080]> MS
RL   ..[#808080]> MS

' -----------------------------
' Dashboard reads (informational)
' -----------------------------
MS -[#000000,thickness=2]-> DASH
MT -[#000000,thickness=2]-> DASH
EM -[#000000,thickness=2]-> DASH
OT -[#000000,thickness=2]-> DASH

' -----------------------------
' Hidden layout hints (local-friendly)
' -----------------------------
HIST_PV -[hidden]-> HIST_W
HIST_W -[hidden]-> FORECAST_API
FORECAST_API -[hidden]-> RL
RL -[hidden]-> PB
MS -[hidden]-> MT
LSTM -[hidden]-> PVLIB
PVLIB -[hidden]-> TFT
LSTM -[hidden]-> TFT

@enduml