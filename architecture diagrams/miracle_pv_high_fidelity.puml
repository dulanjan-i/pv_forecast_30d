@startuml
' High-fidelity PlantUML — local / VS Code rendering
' Hybrid Ensemble PV Forecasting Architecture (Final)

' -----------------------------
' Styling
' -----------------------------
skinparam backgroundColor ***REMOVED***FFFFFF
skinparam componentStyle rectangle
skinparam databaseBackgroundColor ***REMOVED***F5F5F5
skinparam rectangleBorderColor ***REMOVED***0066cc
skinparam linetype ortho
skinparam shadowing false
skinparam defaultTextAlignment center

title Hybrid Ensemble PV Forecasting Architecture (Final) - High fidelity

' -----------------------------
' Colors (explicit)
' -----------------------------
' inputs:    ***REMOVED***d6f5d6
' models:    ***REMOVED***cce0ff
' stores:    ***REMOVED***f2f2f2
' error:     ***REMOVED***ffe0b3
' output:    ***REMOVED***fff5b3
' dashboard: ***REMOVED***ccf5f5

' -----------------------------
' Data Sources (top)
' -----------------------------
package "Data Source 1: PV Plant" as DS1 ***REMOVED***d6f5d6 {
    [Historical PV Output] as HIST_PV
    [Historical Weather Data] as HIST_W
    [PV Plant Metadata] as PVM
}

package "Data Source 2: OpenMeteo (Forecasts)" as DS2 ***REMOVED***d6f5d6 {
    [Forecast API] as FORECAST_API
    package "Ensemble API" as ENS {
        [GFS Ensemble] as GFS
        [ICON EPS] as ICON_EPS
        [ICON EU] as ICON_EU
        [ICON D2] as ICON_D2
        [ECMWF IFS] as ECMWF_IFS
        [ECMWF AIFS] as ECMWF_AIFS
        [GEM Global] as GEM
    }
}

' -----------------------------
' RL Meta-Controller (center)
' -----------------------------
node "RL Meta-Controller\n(Adaptive Control Loop)" as RL ***REMOVED***cce0ff

' -----------------------------
' Historical Store + Preprocessors
' -----------------------------
database "Historical Store" as HDB ***REMOVED***f2f2f2
rectangle "Preprocessor A\n(Data Normalization)" as PA ***REMOVED***cce0ff
rectangle "Preprocessor B\n(Real-time Preprocessing)" as PB ***REMOVED***cce0ff

' -----------------------------
' Stores & Outputs
' -----------------------------
database "Feature Store" as FS ***REMOVED***f2f2f2
database "Model Store" as MS ***REMOVED***f2f2f2
database "Metadata Table\n(Pipeline & Model Metadata)" as MT ***REMOVED***f2f2f2
database "Error Metrics Table" as EM ***REMOVED***ffe0b3
database "TFT Output Table" as OT ***REMOVED***f2f2f2

' -----------------------------
' Models
' -----------------------------
rectangle "LSTM Encoder\n(Temporal Encodings)" as LSTM ***REMOVED***cce0ff
rectangle "PVLib Physical Model\n(Baseline physics simulation)" as PVLIB ***REMOVED***cce0ff
rectangle "Temporal Fusion Transformer\n(Main Forecasting Model)" as TFT ***REMOVED***cce0ff

' -----------------------------
' Dashboard & Final Output
' -----------------------------
rectangle "Streamlit Dashboard\n(Explainability & Decision Support)" as DASH ***REMOVED***ccf5f5
rectangle "Predicted PV Power Output" as OUT ***REMOVED***fff5b3

' =====================================================
' Arrow thickness rules
'  - main: thickness 3
'  - DS2 -> RL inputs: thickness 2
'  - feedback/dotted: thickness 2
' =====================================================

' -----------------------------
' Main arrows thickness
' -----------------------------
skinparam ArrowThickness 3

' Historical flow -> preprocess -> LSTM -> FS
HIST_PV -[***REMOVED***000000,thickness=3]-> HDB
HIST_W  -[***REMOVED***000000,thickness=3]-> HDB
HDB     -[***REMOVED***000000,thickness=3]-> PA
PA      -[***REMOVED***000000,thickness=3]-> LSTM
LSTM    -[***REMOVED***000000,thickness=3]-> FS

' PV metadata -> PVLib -> FS
PVM     -[***REMOVED***000000,thickness=3]-> PVLIB
PVLIB   -[***REMOVED***000000,thickness=3]-> FS

' -----------------------------
' DS2 inputs -> RL (slightly thinner) connecting to top of RL
' -----------------------------
skinparam ArrowThickness 2
FORECAST_API -top-> RL
GFS          -top-> RL
ICON_EPS     -top-> RL
ICON_EU      -top-> RL
ICON_D2      -top-> RL
ECMWF_IFS    -top-> RL
ECMWF_AIFS   -top-> RL
GEM          -top-> RL

' restore main thickness for downstream
skinparam ArrowThickness 3

' -----------------------------
' RL -> Preprocessor B (center-bottom to center-top) — main thickness
' -----------------------------
RL -bottom-> PB
PB -[***REMOVED***000000,thickness=3]-> FS

' -----------------------------
' TFT input aggregation and outputs
' -----------------------------
FS -[***REMOVED***000000,thickness=3]-> TFT
PVLIB -[***REMOVED***000000,thickness=3]-> TFT
PB -[***REMOVED***000000,thickness=3]-> TFT

TFT -[***REMOVED***000000,thickness=3]-> OT
OT  -[***REMOVED***000000,thickness=3]-> DASH
OT  -[***REMOVED***000000,thickness=3]-> EM
OT  -[***REMOVED***000000,thickness=3]-> OUT

' -----------------------------
' Feedback (thin) and dotted storage link from bottom of RL
' -----------------------------
skinparam ArrowThickness 2
EM -[***REMOVED***000000,thickness=2]-> RL
RL -bottom..> MS : store policies

' -----------------------------
' Model store secondary dotted links
' -----------------------------
LSTM ..[***REMOVED***808080]> MS
PVLIB ..[***REMOVED***808080]> MS
TFT ..[***REMOVED***808080]> MS
RL   ..[***REMOVED***808080]> MS

' -----------------------------
' Dashboard reads (informational)
' -----------------------------
MS -[***REMOVED***000000,thickness=2]-> DASH
MT -[***REMOVED***000000,thickness=2]-> DASH
EM -[***REMOVED***000000,thickness=2]-> DASH
OT -[***REMOVED***000000,thickness=2]-> DASH

' -----------------------------
' Hidden layout hints (local-friendly)
' -----------------------------
HIST_PV -[hidden]-> HIST_W
HIST_W -[hidden]-> FORECAST_API
FORECAST_API -[hidden]-> RL
RL -[hidden]-> PB
MS -[hidden]-> MT
LSTM -[hidden]-> PVLIB
PVLIB -[hidden]-> TFT
LSTM -[hidden]-> TFT

@enduml